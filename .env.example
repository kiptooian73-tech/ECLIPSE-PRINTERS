# Server configuration
PORT=3000

# WhatsApp checkout
MERCHANT_WHATSAPP=254741296101

# Admin email notifications (optional; orders will be logged locally if not set)
ADMIN_EMAIL=your-email@example.com
ADMIN_TOKEN=your-secret-admin-token

# For production, restrict frontend origins allowed by CORS.
# Example: CORS_ORIGINS=https://example.com,https://www.example.com
CORS_ORIGINS=http://localhost:3000

# SMTP settings for email notifications (using Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password

# Note: For Gmail, generate an App Password at https://myaccount.google.com/apppasswords
# For other SMTP providers (SendGrid, Mailgun, etc.), use their credentials.

# Twilio WhatsApp notifications (optional; automatically send orders to merchant via WhatsApp)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=+254700000000

# Note: Get Twilio credentials at https://www.twilio.com/console
# TWILIO_WHATSAPP_NUMBER is your Twilio sandbox or approved sender number
